# ============================================================
# NF Automation - Variaveis de ambiente
# Edite este arquivo e salve como .env (permissao 0600)
# ============================================================

# ── SAP S/4HANA Public Cloud (SAP_COM_0057) ────────────────
SAP_BASE_URL=https://myXXXXXX-api.s4hana.cloud.sap
SAP_AUTH_METHOD=basic
SAP_USERNAME=COMM_USER
SAP_PASSWORD=__PREENCHER__

# Opcional (se for usar OAuth em vez de Basic):
# SAP_OAUTH_TOKEN_URL=
# SAP_OAUTH_CLIENT_ID=
# SAP_OAUTH_CLIENT_SECRET=

# ── Pipefy ──────────────────────────────────────────────────
PIPEFY_TOKEN=__PREENCHER__
WEBHOOK_SECRET=__GERAR_TOKEN_FORTE__
TRIGGER_PHASE_ID=

# ── Pos-lancamento ──────────────────────────────────────────
NEXT_PHASE_ID=
MANUAL_TRIGGER_TOKEN=__GERAR_TOKEN_FORTE__

# ── Flask ───────────────────────────────────────────────────
FLASK_DEBUG=false
PORT=8009

# ── Opcionais usados pelas ferramentas (tools/) ─────────────
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_NCM=
# PIPEFY_PIPE_ID=
# PIPEFY_REPORT_ID=
# PIPEFY_REPORT_ID_AJUSTES=
